# Telegram Userbot MTProto Credentials
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_NAME=poster_session

# Telegram Admin Bot Credentials
BOT_TOKEN=your_bot_token
ADMIN_USER_IDS=12345678,87654321

# Google Gemini AI Credentials
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Conservative Telegram RPC spacing and rest between full discovery cycles
DISCOVERY_RPC_MIN_SECONDS=4
DISCOVERY_RPC_MAX_SECONDS=8
DISCOVERY_CYCLE_SECONDS=300

# Supabase Cloud Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# Web Dashboard Settings
WEB_HOST=127.0.0.1
WEB_PORT=8000
